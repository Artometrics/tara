---
import Ornament from "./Ornament.astro";
import { site } from "../data/site";

interface Props {
  signup?: boolean;
}
const { signup = true } = Astro.props;
---

{signup && (
<section class="notes" id="stay" aria-labelledby="stay-title">
  <h2 class="caps" id="stay-title">Follow the planning</h2>
  <Ornament />
  <p>Planning notes, outfit hunts and budget diaries, delivered when there is something worth sending. The newsletter is a draft: signups stay in this browser.</p>
  <form class="signup" data-newsletter-form novalidate>
    <label class="email-line">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <button class="orn-btn" type="submit">
      <i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i>
      Save my spot
    </button>
    <p class="form-status" data-newsletter-status role="status" aria-live="polite"></p>
  </form>
</section>
)}
<footer class="site-footer" id="footer">
  <p class="footer-lockup">
    <svg viewBox="0 0 320 92" role="img" aria-label="Tara">
      <path d="M70 46h50M200 46h50" fill="none" stroke="currentColor" stroke-width="1"></path>
      <path d="M160 14 192 46 160 78 128 46Z" fill="none" stroke="currentColor" stroke-width="1"></path>
      <path d="M160 24 182 46 160 68 138 46Z" fill="none" stroke="currentColor" stroke-width="0.7"></path>
      <text x="160" y="55" text-anchor="middle" fill="currentColor">TARA</text>
    </svg>
  </p>
  <div class="footer-links">
    <div>
      <h2>Explore</h2>
      <a href="/about">About Tara</a>
      <a href="/weddings">The Three Weddings</a>
      <a href="/lookbook">Lookbook</a>
      <a href="/journal">Journal</a>
    </div>
    <div>
      <h2>Work together</h2>
      <a href="/partner">Partner with me</a>
      <a href="/newsletter">Newsletter (draft)</a>
      <a href={`mailto:${site.contactEmail}`}>Email (placeholder)</a>
    </div>
    <p class="fine">
      Draft preview. Not indexed by search engines. Images are AI-generated illustrations, not photographs of Tara or of real
      venues. Nothing here is for sale, and there are no accounts, payments or tracking. Social handles and contact details are
      placeholders.
    </p>
  </div>
</footer>
