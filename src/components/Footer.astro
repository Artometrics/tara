---
import Ornament from "./Ornament.astro";
---
<section class="notes" id="stay" aria-label="Messages">
  <h2 class="caps">Stay in touch</h2>
  <Ornament />
  <p>Keep up to date on the latest happenings in our world—launches, updates to our Impact Report, and more—when you subscribe.</p>
  <form id="newsletter-form" novalidate>
    <label class="email-line">
      <span>Email address</span>
      <input type="email" name="email" disabled autocomplete="off" />
    </label>
  </form>
</section>
<footer class="site-footer" id="footer">
  <p class="footer-lockup">
    <svg viewBox="0 0 320 92" role="img" aria-label="Prism &amp; Pollen">
      <path d="M28 46c8-10 14-14 22-14s14 4 22 14-14 14-22 14-14-4-22-14zm44 0c8-10 14-14 22-14s14 4 22 14-14 14-22 14-14-4-22-14z" fill="none" stroke="#2a241e" stroke-width="1"/>
      <path d="M248 46c8-10 14-14 22-14s14 4 22 14-14 14-22 14-14-4-22-14z" fill="none" stroke="#2a241e" stroke-width="1"/>
      <path d="M108 28h104c16 0 24 8 24 18s-8 18-24 18H108c-16 0-24-8-24-18s8-18 24-18z" fill="none" stroke="#2a241e" stroke-width="1"/>
      <path d="M108 34h104c12 0 18 5 18 12s-6 12-18 12H108c-12 0-18-5-18-12s6-12 18-12z" fill="none" stroke="#2a241e" stroke-width="0.7"/>
      <path d="M160 22v6M160 64v6M148 28l-4-6M172 28l4-6M148 64l-4 6M172 64l4 6" stroke="#2a241e" stroke-width="0.8"/>
      <text x="160" y="50" text-anchor="middle" fill="#2a241e">PRISM &amp; POLLEN</text>
    </svg>
  </p>
  <div class="footer-links">
    <div>
      <a href="/pages/not-in-preview">Accessibility</a>
      <a href="/pages/privacy">Your privacy choices</a>
      <a href="/pages/terms">Terms of use</a>
      <a href="/pages/privacy">Legal &amp; privacy</a>
    </div>
    <p class="fine">Prototype. Not a store. No index. Reference photographs, locations, and the newsletter sentence are not Prism &amp; Pollen offers. Rights not cleared. Stock unknown. Payments off.</p>
    <div>
      <a href="/pages/not-in-preview">Track your order</a>
      <a href="/pages/not-in-preview">Start a return</a>
      <a href="/pages/not-in-preview">Manage pre-order</a>
      <a href="/products/digital-gift-card">Gift cards</a>
      <a href="/pages/shops">Find a shop</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact us</a>
      <a href="/pages/not-in-preview">Careers</a>
      <a href="/pages/assistance">Live chat</a>
    </div>
  </div>
</footer>
