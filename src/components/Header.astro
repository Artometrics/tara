---
import Picture from "./Picture.astro";
import { lookbookMenu, menuPhotos, weddingsMenu } from "../data/site";

interface Props {
  current?: string;
}
const { current = "" } = Astro.props;
const here = (prefix: string) => (current === prefix || current.startsWith(`${prefix}/`) ? "page" : undefined);
---

<a class="skip" href="#content">Skip to content</a>
<p class="announce">Draft preview · illustrative AI images · nothing for sale</p>
<header class="site-header" id="site-header">
  <div class="bar">
    <div class="left">
      <button
        class="icon-btn mobile-toggle"
        id="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="menu-dialog"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
      </button>
      <nav class="desktop-nav" aria-label="Primary">
        <a class="nav-btn" href="/about" aria-current={here("/about")}>About</a>
        <div class="nav-item" id="weddings-wrap">
          <button class="nav-btn" id="weddings-button" type="button" aria-expanded="false" aria-controls="mega-weddings">
            The Weddings
          </button>
          <div class="mega" id="mega-weddings">
            {
              weddingsMenu.map((column) => (
                <div>
                  <h2>{column.title}</h2>
                  {column.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </div>
              ))
            }
            <a class="mega-photo" href="/weddings" tabindex="-1" aria-hidden="true">
              <Picture name={menuPhotos.weddings} sizes="(min-width: 980px) 40vw, 0px" alt="" />
            </a>
          </div>
        </div>
        <div class="nav-item" id="lookbook-wrap">
          <button class="nav-btn" id="lookbook-button" type="button" aria-expanded="false" aria-controls="mega-lookbook">
            Lookbook
          </button>
          <div class="mega" id="mega-lookbook">
            {
              lookbookMenu.map((column) => (
                <div>
                  <h2>{column.title}</h2>
                  {column.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </div>
              ))
            }
            <a class="mega-photo" href="/lookbook" tabindex="-1" aria-hidden="true">
              <Picture name={menuPhotos.lookbook} sizes="(min-width: 980px) 40vw, 0px" alt="" position="center 30%" />
            </a>
          </div>
        </div>
        <a class="nav-btn" href="/journal" aria-current={here("/journal")}>Journal</a>
      </nav>
    </div>
    <a class="wordmark" href="/" aria-label="Tara, home">Tara</a>
    <div class="right">
      <a class="util-link" href="/partner" aria-current={here("/partner")}>Partner with me</a>
      <a class="util-link" href="/newsletter" aria-current={here("/newsletter")}>Newsletter</a>
      <a class="icon-btn mobile-toggle" href="/newsletter" aria-label="Newsletter draft">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="12"></rect><path d="m4 7 8 6 8-6"></path></svg>
      </a>
    </div>
  </div>
</header>
