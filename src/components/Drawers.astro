---
import { lookbookMenu, primaryLinks, weddingsMenu } from "../data/site";
---

<dialog class="drawer menu-dialog" id="menu-dialog" aria-labelledby="menu-title">
  <div class="menu-head">
    <p class="menu-kicker" id="menu-title">Menu</p>
    <button class="icon-btn" type="button" data-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 18 18M18 6 6 18"></path></svg>
    </button>
  </div>
  <div class="menu-body">
    <a class="menu-link" href="/about">About Tara</a>
    <button class="acc-btn" type="button" data-acc aria-expanded="false" aria-controls="acc-weddings">
      The Weddings <span class="menu-arrow" aria-hidden="true"></span>
    </button>
    <div class="acc-panel" id="acc-weddings" hidden>
      {
        weddingsMenu.map((column) => (
          <div>
            <h2 class="quiet">{column.title}</h2>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </div>
    <button class="acc-btn" type="button" data-acc aria-expanded="false" aria-controls="acc-lookbook">
      Lookbook <span class="menu-arrow" aria-hidden="true"></span>
    </button>
    <div class="acc-panel" id="acc-lookbook" hidden>
      {
        lookbookMenu.map((column) => (
          <div>
            <h2 class="quiet">{column.title}</h2>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </div>
    <a class="menu-link" href="/journal">Journal <span class="menu-arrow" aria-hidden="true"></span></a>
    <div class="menu-foot">
      {
        primaryLinks
          .filter((link) => link.href === "/partner" || link.href === "/newsletter")
          .map((link) => (
            <a class="menu-link" href={link.href}>
              {link.label} <span class="menu-arrow" aria-hidden="true"></span>
            </a>
          ))
      }
    </div>
  </div>
</dialog>
