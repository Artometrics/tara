---
import { paletteHex, type Motif, type PaletteKey } from "../data/looks";

interface Props {
  motif: Motif;
  palette?: PaletteKey[];
  ratio?: "3/4" | "4/3" | "16/9" | "1/1";
  label?: string;
  quiet?: boolean;
}

const { motif, palette = ["blush", "ivory"], ratio = "3/4", label = "Image slot", quiet = false } = Astro.props;
const first = paletteHex[palette[0]] ?? "#F2D6CE";
const second = paletteHex[palette[1] ?? "ivory"] ?? "#FBF5EA";
const style = `--plate-a:${first};--plate-b:${second};aspect-ratio:${ratio}`;
---

<div class="plate" style={style} role="img" aria-label={`${label}. Illustrative placeholder, no photograph supplied.`}>
  <svg viewBox="0 0 120 160" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    {motif === "veil" && (
      <g>
        <path d="M24 150V58a36 36 0 0 1 72 0v92" />
        <path d="M60 52c-9 0-13 8-13 15 0 5 3 9 5 11l-3 56h22l-3-56c2-2 5-6 5-11 0-7-4-15-13-15Z" />
        <path d="M52 62c-14 20-26 52-28 88M68 62c14 20 26 52 28 88" />
      </g>
    )}
    {motif === "dupatta" && (
      <g>
        <path d="M60 36c-5 0-8 4-8 8s2 7 4 9l-6 22-18 58h56l-18-58-6-22c2-2 4-5 4-9s-3-8-8-8Z" />
        <path d="M56 54c-16 8-26 28-30 60M64 54c16 8 26 28 30 60" />
        <path d="M30 140c20-8 40-8 60 0" />
        <circle cx="60" cy="108" r="2" />
        <circle cx="48" cy="124" r="1.5" />
        <circle cx="72" cy="124" r="1.5" />
      </g>
    )}
    {motif === "marigold" && (
      <g>
        <circle cx="42" cy="58" r="14" />
        <circle cx="42" cy="58" r="8" />
        <circle cx="42" cy="58" r="3" />
        <circle cx="82" cy="84" r="18" />
        <circle cx="82" cy="84" r="11" />
        <circle cx="82" cy="84" r="4" />
        <circle cx="46" cy="116" r="12" />
        <circle cx="46" cy="116" r="6" />
        <path d="M60 140c-2-12 4-22 12-30" />
      </g>
    )}
    {motif === "arch" && (
      <g>
        <path d="M30 150V82M90 150V82M30 82h60" />
        <path d="M24 82c8-26 20-40 36-40s28 14 36 40" />
        <path d="M44 82v22M60 82v30M76 82v22" />
        <path d="M30 150h60M20 150h80" />
        <circle cx="24" cy="142" r="2" />
        <circle cx="96" cy="142" r="2" />
      </g>
    )}
    {motif === "table" && (
      <g>
        <path d="M14 40c14 14 78 14 92 0" />
        <circle cx="34" cy="53" r="3" />
        <circle cx="60" cy="58" r="3" />
        <circle cx="86" cy="53" r="3" />
        <path d="M10 112h100M14 112l-4 36M106 112l4 36" />
        <path d="M30 112c0-8 6-12 12-12M90 112c0-8-6-12-12-12" />
        <path d="M60 112V96M56 96h8" />
        <path d="M60 86c-3 3-3 7 0 9 3-2 3-6 0-9Z" />
      </g>
    )}
    {motif === "lemon" && (
      <g>
        <circle cx="60" cy="62" r="34" />
        <path d="M60 96v52M48 148h24" />
        <ellipse cx="44" cy="54" rx="5" ry="4" />
        <ellipse cx="68" cy="46" rx="5" ry="4" />
        <ellipse cx="76" cy="72" rx="5" ry="4" />
        <ellipse cx="50" cy="78" rx="5" ry="4" />
      </g>
    )}
    {motif === "aisle" && (
      <g>
        <path d="M34 56a26 26 0 0 1 52 0v28H34Z" />
        <path d="M54 150l4-66M66 150l-4-66" />
        <path d="M26 100h14M26 114h18M26 128h22M80 100h14M76 114h18M72 128h22" />
        <path d="M20 150h80" />
      </g>
    )}
    {motif === "jacket" && (
      <g>
        <path d="M38 40l22 12 22-12 16 24-12 12v62H34V76L22 64Z" />
        <path d="M60 52v86" />
        <circle cx="60" cy="86" r="2" />
        <circle cx="60" cy="104" r="2" />
        <circle cx="60" cy="122" r="2" />
      </g>
    )}
  </svg>
  {!quiet && <p>{label}</p>}
</div>
