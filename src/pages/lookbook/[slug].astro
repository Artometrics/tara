---
import Base from "../../components/Base.astro";
import LookCard from "../../components/LookCard.astro";
import Ornament from "../../components/Ornament.astro";
import Picture from "../../components/Picture.astro";
import Plate from "../../components/Plate.astro";
import { celebrationById } from "../../data/site";
import { looks, momentLabels, neighbors, paletteHex, paletteLabels, type Look } from "../../data/looks";

export function getStaticPaths() {
  return looks.map((look) => ({ params: { slug: look.slug }, props: { look } }));
}

interface Props {
  look: Look;
}

const { look } = Astro.props;
const celebration = celebrationById(look.celebration);
const { prev, next } = neighbors(look.slug);
const more = looks.filter((item) => item.celebration === look.celebration && item.slug !== look.slug).slice(0, 3);
---

<Base title={look.title} description={look.summary}>
  <article class="pdp">
    <div class="pdp-gallery">
      <div class="frame detail-frame">
        {
          look.image ? (
            <Picture name={look.image} sizes="(min-width: 900px) 50vw, 100vw" eager />
          ) : (
            <Plate motif={look.motif} palette={look.palette} label={`${celebration.name} look`} />
          )
        }
      </div>
    </div>
    <div class="pdp-info">
      <p class="kicker dark"><a href="/lookbook">Lookbook</a> · {celebration.name} · {momentLabels[look.moment]}</p>
      <h1>{look.title}</h1>
      <Ornament />
      <p class="quiet">{look.mood}</p>
      <ul class="swatches" aria-label="Color story">
        {
          look.palette.map((key) => (
            <li>
              <span class="swatch" style={`background:${paletteHex[key]}`}></span>
              {paletteLabels[key]}
            </li>
          ))
        }
      </ul>
      <p class="summary">{look.summary}</p>
      <p class="inspiration-note">Inspiration only. Not for sale, and no designer or shop is named.</p>
      <div class="tabs" role="tablist" aria-label="Look notes">
        <button type="button" role="tab" id="tab-why" aria-controls="panel-why" data-tab="why" aria-selected="true">Why it's here</button>
        <span aria-hidden="true">·</span>
        <button type="button" role="tab" id="tab-details" aria-controls="panel-details" data-tab="details" aria-selected="false" tabindex="-1">Details</button>
        <span aria-hidden="true">·</span>
        <button type="button" role="tab" id="tab-questions" aria-controls="panel-questions" data-tab="questions" aria-selected="false" tabindex="-1">Questions</button>
      </div>
      <div class="panel" id="panel-why" data-panel="why" role="tabpanel" aria-labelledby="tab-why">
        {look.whyItsHere.map((paragraph) => <p>{paragraph}</p>)}
        <p class="quiet"><strong>Content idea.</strong> {look.contentIdea}</p>
      </div>
      <div class="panel" id="panel-details" data-panel="details" role="tabpanel" aria-labelledby="tab-details" hidden>
        <dl class="facts stacked">
          <div><dt>Silhouette</dt><dd>{look.silhouette}</dd></div>
          <div><dt>Fabric ideas</dt><dd>{look.fabricIdeas}</dd></div>
          <div><dt>Finishing touches</dt><dd>{look.finishingTouches}</dd></div>
        </dl>
      </div>
      <div class="panel" id="panel-questions" data-panel="questions" role="tabpanel" aria-labelledby="tab-questions" hidden>
        <ul>
          {look.questions.map((question) => <li>{question}</li>)}
        </ul>
      </div>
      <p class="pager">
        <a href={`/lookbook/${prev.slug}`} rel="prev">← {prev.title}</a>
        <a href={`/lookbook/${next.slug}`} rel="next">{next.title} →</a>
      </p>
    </div>
  </article>

  {
    more.length > 0 ? (
      <>
        <section class="section">
          <h2 class="script">More from {celebration.name}</h2>
          <Ornament />
        </section>
        <div class="card-grid">
          {more.map((item) => <LookCard look={item} />)}
        </div>
      </>
    ) : null
  }
</Base>
