---
import Base from "../../components/Base.astro";
import JournalCard from "../../components/JournalCard.astro";
import Ornament from "../../components/Ornament.astro";
import { draftNotice, posts } from "../../data/journal";
---

<Base title="Journal" description="Six starter drafts on lehenga shopping, venue scouting, fusion ceremonies, budgets and more.">
  <header class="page-head">
    <p class="kicker dark">Starter drafts</p>
    <h1 class="script">Journal</h1>
    <Ornament />
    <p class="lede">{draftNotice}</p>
  </header>
  <div class="card-grid journal-grid">
    {posts.map((post) => <JournalCard post={post} />)}
  </div>
</Base>
