---
import Base from "../components/Base.astro";
import JournalCard from "../components/JournalCard.astro";
import LookCard from "../components/LookCard.astro";
import Ornament from "../components/Ornament.astro";
import Picture from "../components/Picture.astro";
import { posts } from "../data/journal";
import { getLook } from "../data/looks";
import { celebrations, site } from "../data/site";

const featuredLooks = [
  getLook("silk-column-and-cathedral-veil"),
  getLook("blush-lehenga-net-dupatta"),
  getLook("terracotta-welcome-dinner"),
];
const latest = posts.slice(0, 3);
---

<Base title={site.name} description={site.description}>
  <section class="hero" id="hero">
    <Picture name="hero-lehenga" sizes="100vw" eager position="30% center" />
    <div class="hero-copy">
      <p class="kicker">Bridal creator in the making</p>
      <h1 class="caps">One bride, three celebrations</h1>
      <Ornament />
      <p class="hero-sub">India. Italy. America. The planning, the outfits and the real costs, shared as they happen.</p>
      <p class="hero-actions">
        <a class="orn-btn solid" href="/weddings">
          <i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i>
          The three weddings
        </a>
        <a class="text-link on-dark" href="/journal">Read the journal</a>
      </p>
    </div>
  </section>

  <section class="section intro" id="hello">
    <h2 class="script">Hello, I'm Tara</h2>
    <Ornament />
    <p class="lede">
      I'm planning to marry in about two years, and I'm planning three celebrations: one in India, one in Italy and one in
      America. This is where I will work it all out in public. If it also helps pay for the wedding, that will be shared
      honestly too.
    </p>
    <p><a class="text-link" href="/about">More about Tara</a></p>
  </section>

  <div class="tout-row" id="touts">
    <a class="story" href="/lookbook">
      <Picture name="look-silk-gown" sizes="(min-width: 900px) 50vw, 100vw" position="center 30%" />
      <span class="story-label">Lookbook<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
    <a class="story" href="/journal">
      <Picture name="creator-flatlay" sizes="(min-width: 900px) 50vw, 100vw" />
      <span class="story-label">Journal<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
  </div>

  <section class="explore" id="explore">
    <h2 class="script explore-title">The three weddings</h2>
    <div class="explore-collage" aria-label="The three celebrations">
      {
        celebrations.map((item, index) => (
          <a class:list={["explore-card", `ex-${index + 1}`]} href={`/weddings#${item.id}`}>
            <Picture name={item.image} sizes="(min-width: 900px) 30vw, 90vw" />
            <span class="explore-label">
              <small>{item.kicker}</small>
              {item.name}
            </span>
          </a>
        ))
      }
    </div>
    <p class="explore-foot"><a class="text-link" href="/weddings#together">How the three fit together</a></p>
  </section>

  <section class="section" id="featured">
    <h2 class="script">From the lookbook</h2>
    <Ornament />
    <p class="lede">Inspiration, not a shop. Each look is an idea to test, with the questions worth asking before anything is ordered.</p>
  </section>
  <div class="card-grid featured-looks">
    {featuredLooks.map((look) => <LookCard look={look} />)}
  </div>
  <p class="section-foot"><a class="text-link" href="/lookbook">See every look</a></p>

  <section class="section" id="latest">
    <h2 class="script">From the journal</h2>
    <Ornament />
    <p class="lede">Six starter drafts, written as a planning framework. Tara will swap in her real stories.</p>
  </section>
  <div class="card-grid">
    {latest.map((post) => <JournalCard post={post} />)}
  </div>
  <p class="section-foot"><a class="text-link" href="/journal">All journal drafts</a></p>

  <section class="band fund" id="fund">
    <div>
      <h2 class="script">A transparent wedding fund</h2>
      <Ornament />
      <p>
        Part of the reason for this site is to help cover the dress and the planning. The plan is to say so openly: what is
        earned, what it goes toward and which posts are partnerships. No figures are published yet, because nothing has been
        earned.
      </p>
      <p><a class="text-link" href="/partner">Partner with me</a></p>
    </div>
  </section>
</Base>
