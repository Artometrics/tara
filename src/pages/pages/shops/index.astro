---
import Base from "../../../components/Base.astro";
import { utilityPage } from "../../../data/catalog";

const page = utilityPage("shops");
if (!page) throw new Error("Missing shops page");
---

<Base title={page.title} description={page.paragraphs[0]}>
  <header class="page-head">
    <p class="quiet">{page.kicker}</p>
    <h1 class="script">{page.title}</h1>
  </header>
  <div class="prose">
    {page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p><a href="/pages/shops/unpublished">Shop detail</a> — not published.</p>
  </div>
</Base>
